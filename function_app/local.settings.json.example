    "FOUNDRY_RESOURCE": "<your-foundry-resource>",
    "CLAUDE_MODEL": "claude-sonnet-4-6",

    "NOTIFY_WEBHOOK_URL": "https://outlook.office.com/webhook/...",

    "_comment_auth": "Leave ADO_PAT unset to use managed identity (preferred). Only set it (from Key Vault) if Entra integration with the ADO org is not yet available.",
